{
  "name": "agent-trail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "catalog": {
    "ajv": "^8.20.0",
    "canonicalize": "^3.0.0",
    "semver": "^7.6.0"
  },
  "scripts": {
    "check": "bun run check:schema && bun run check:types && bun run check:source-types && bun run check:conformance && bun run check:hash-vectors && bun run check:redaction-docs && bun run typecheck && bun run lint && bun run test && bun pm ls --all >/dev/null && bun run --workspaces --sequential check",
    "check:schema": "bun run scripts/check-schema-sync.ts --check",
    "check:conformance": "bun run scripts/check-conformance.ts --check",
    "check:hash-vectors": "env GOROOT= GOTOOLCHAIN=local GOCACHE=/tmp/agent-trail-go-build-cache go test -mod=readonly ./scripts && env GOROOT= GOTOOLCHAIN=local GOCACHE=/tmp/agent-trail-go-build-cache go run -mod=readonly ./scripts/hash-vector-oracle.go --check",
    "check:types": "bun run scripts/generate-types.ts --check",
    "check:source-types": "bun run scripts/generate-source-types.ts --check",
    "check:redaction-docs": "bun run scripts/generate-redaction-docs.ts --check",
    "format": "biome format --write",
    "generate:types": "bun run scripts/generate-types.ts",
    "generate:source-types": "bun run scripts/generate-source-types.ts",
    "generate:redaction-docs": "bun run scripts/generate-redaction-docs.ts",
    "sync:schema": "bun run scripts/check-schema-sync.ts",
    "sync:conformance": "bun run scripts/check-conformance.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "bun run worktree:setup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "worktree:cleanup": "bun run scripts/worktree-workflow.ts cleanup",
    "worktree:doctor": "bun run scripts/worktree-workflow.ts doctor",
    "worktree:setup": "bun run scripts/worktree-workflow.ts setup",
    "worktree:sync-main": "bun run scripts/worktree-workflow.ts sync-main"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "ajv": "catalog:",
    "bun-types": "1.3.14",
    "h3-v2": "npm:h3@2.0.1-rc.20",
    "json-schema-to-typescript": "^15.0.4",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  }
}
